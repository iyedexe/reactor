# SITE_ADDRESS is either your domain (public VPS: automatic HTTPS via Let's Encrypt)
# or ":80" (behind a Cloudflare Tunnel, which terminates TLS at Cloudflare).
{
	servers {
		trusted_proxies static private_ranges
	}
}

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	log {
		output stdout
		format json
	}
}

{$SITE_ADDRESS} {
	import common

	# Smart links go to the dedicated links service.
	@links path /r/* /m/*
	handle @links {
		reverse_proxy links:3002
	}

	handle {
		reverse_proxy web:3000 {
			health_uri /api/health
			health_interval 30s
		}
	}
}

# Optional short links domain (LINKS_SITE_ADDRESS, e.g. avb.fr). Everything else redirects to the app.
{$LINKS_SITE_ADDRESS} {
	import common
	@links path /r/* /m/*
	handle @links {
		reverse_proxy links:3002
	}
	handle {
		respond "Not found" 404
	}
}
