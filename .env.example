# ─────────────────────────────────────────────────────────────────────────────
# AvisBoost configuration. Copy to .env and fill in. Never commit .env.
# Every *_MODE defaults to a mock, so the platform runs end to end without any
# external account; switch each one to its real provider when you have the keys.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
# Public URL of the app (used in e-mails, auth callbacks).
APP_URL=https://app.example.fr
# Public base URL of smart links /r/{code} (phase 3). Can be a shorter domain. Defaults to APP_URL.
LINKS_URL=
# 32+ random characters: `openssl rand -base64 48`. Changing it logs everyone out.
APP_SECRET=
# First platform admin (created by the seed / promoted on first sign-in).
ADMIN_EMAIL=admin@example.fr
LOG_LEVEL=info

# ── Database (docker-compose builds DATABASE_URL from these) ────────────────
POSTGRES_USER=avisboost
POSTGRES_PASSWORD=
POSTGRES_DB=avisboost
# Only for running apps outside Docker (local dev):
DATABASE_URL=postgresql://avis:avis@localhost:5432/avisboost

# ── Reverse proxy (Caddy) ────────────────────────────────────────────────────
# Public VPS: your domain, e.g. app.example.fr (Caddy obtains HTTPS certificates).
# Home server behind Cloudflare Tunnel: ":80" (Cloudflare terminates HTTPS).
SITE_ADDRESS=app.example.fr
HTTP_PORT=80
HTTPS_PORT=443
# Cloudflare Tunnel token (only with `docker compose --profile tunnel up -d`).
CLOUDFLARE_TUNNEL_TOKEN=

# ── Images (Jenkins / registry) ──────────────────────────────────────────────
REGISTRY=avisboost
TAG=latest

# ── Google Business Profile (reviews + replies) ─────────────────────────────
# mock = realistic seeded data (until Google approves API access), live = real API.
GOOGLE_MODE=mock
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# OAuth refresh token of the Google account that manages your clients' profiles.
GOOGLE_REFRESH_TOKEN=
# Mock mode only: worker adds a few fake new reviews every 20 minutes (demos).
MOCK_REVIEW_GENERATOR=false

# ── Google Places API (competitor benchmark) ────────────────────────────────
PLACES_MODE=mock
GOOGLE_PLACES_API_KEY=

# ── Claude (review replies + classification) — phase 4 ──────────────────────
LLM_MODE=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_REPLY=
ANTHROPIC_MODEL_CLASSIFY=

# ── E-mail & SMS — phase 5 ───────────────────────────────────────────────────
# console = log messages instead of sending; brevo or twilio for real sending.
MESSAGING_MODE=console
EMAIL_FROM="AvisBoost <no-reply@example.fr>"
BREVO_API_KEY=
# Alphanumeric SMS sender, max 11 chars (e.g. AVISBOOST).
BREVO_SMS_SENDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ── Stripe — phase 7 ─────────────────────────────────────────────────────────
STRIPE_MODE=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ESSENTIEL=
STRIPE_PRICE_PRO=
STRIPE_PRICE_SETUP=
BILLING_GRACE_DAYS=30

# ── File storage (logos, PDF reports) ───────────────────────────────────────
# local = Docker volume; s3 = any S3-compatible store (MinIO, Scaleway, OVH…) — phase 8.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
